# これはサンプル用envファイルです。
# 設定を適用するにはファイル名を.envに変えてください。

# サーバーネーム
server-name=BSMserver

# デフォルトゲームモード
gamemode=survival
# "survival", "creative", "adventure"

# 難易度
difficulty=normal
# "peaceful", "easy", "normal", "hard"

# 許可リスト(trueの場合、別途ファイルの変更が必要)
allow-list=false

# チートを許可するか
allow-cheats=true

# 最大プレイヤー
max-players=20

# IPv4用ポート(NetherNetだとUDP/TCP両方開ける必要あり)
server-port=19132

# IPv6用ポート(NetherNet環境だと無視される)
server-portv6=19133

# NetherNetを使う時のポートの範囲
# 【外部から接続できるIP】:【内部開始ポート】-【内部終了ポート】:【外部開始ポート】-【外部終了ポート】
server-udp-ports=19133-19153

# ワールドネーム
level-name=world

# シード値
level-seed=


# 最新バージョンでは基本nethernetのみ
transport=nethernet